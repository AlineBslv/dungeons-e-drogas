# === PRODUÇÃO - Dungeons e Drogas Backend ===
# Copie este arquivo para .env.production e preencha com os valores reais

# Ambiente
NODE_ENV=production

# Servidor
PORT=4000
FRONTEND_URL=https://seu-dominio.com
NEXT_PUBLIC_VERCEL_URL=https://seu-dominio.vercel.app

# Firebase Admin SDK (Service Account)
FIREBASE_PROJECT_ID=dungeons-e-drogas
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@dungeons-e-drogas.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_AQUI\n-----END PRIVATE KEY-----\n"

# Gemini API
GEMINI_API_KEY=sua_api_key_do_gemini

# Pinecone (opcional - para busca vetorial)
PINECONE_API_KEY=sua_api_key_do_pinecone
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=dungeons-drogas-embeddings

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=50

# Logs
LOG_LEVEL=info
